local ById: { [string]: Find } = {}
local ByZone: { [number]: { Find } } = {}
for _, f in List do
	ById[f.id] = f
	local z = ByZone[f.zone]
	if not z then
		z = {}
		ByZone[f.zone] = z
	end
	table.insert(z, f)
end

return {
	List = List,
	ById = ById,
	ByZone = ByZone,
}
